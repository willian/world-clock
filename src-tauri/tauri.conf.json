{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "World Clock",
  "version": "0.0.0",
  "identifier": "com.willian.world-clock",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "World Clock",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "width": 520,
        "height": 340
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": []
  }
}
